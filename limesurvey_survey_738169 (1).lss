   <row>
    <surveyls_survey_id><![CDATA[738169]]></surveyls_survey_id>
    <surveyls_policy_error/>
    <surveyls_legal_notice/>
    <surveyls_email_invite_subj><![CDATA[Einladung zu einer Umfrage / Ersteinschätzung FASQ]]></surveyls_email_invite_subj>
    <surveyls_email_invite><![CDATA[<p>Liebe Teilnehmende,</p>

<p>hiermit laden wir Sie zu der anonymen Umfrage FASQ ein.<br /><br />Der Titel der die Umfrage '{SURVEYNAME}' und wurde von Prof. Dr. Reinhold Felmann entwickelt, validiert und mit Zustimung, vom FASD Fachzentrum Hamburg e.V. als Online-Umfrage eingepflegt und bereitgestellt.<br /><br />'{SURVEYDESCRIPTION}'<br /><br />Um an dieser Umfrage teilzunehmen, klicken Sie bitte auf den unten stehenden Link.</p>

<p> </p>

<div dir="ltr">
<div><strong>Mit besten Grüßen </strong><br />vom</div>
<span><strong>FASD-Fachzentrum Hamburg e.V.</strong></span></div>
<span>Rothenbaumchaussee 114</span>

<div dir="ltr"><span> 20149 Hamburg<br /><a href="https://fasd-fachzentrum.hamburg">fasd-fachzentrum.hamburg</a> </span></div>

<div><span>info@fasd-fachzentrum.hamburg</span></div>

<div><br /><span><strong><img height="60" src="https://ci3.googleusercontent.com/mail-sig/AIorK4y4KIexZrm9tTYwpKy5i4ajXjUhio3Z7b3GWnsrMF8I8QJeLsk6AvNe76S0wG1HYjPX3FgR6_4" width="200" alt="AIorK4y4KIexZrm9tTYwpKy5i4ajXjUhio3Z7b3GWnsrMF8I8QJeLsk6AvNe76S0wG1HYjPX3FgR6_4" /></strong></span></div>
<br />---------------------------------------------<br />Klicken Sie hier um die Umfrage zu starten:<br />{SURVEYURL}<br /><br />Wenn Sie an diese Umfrage nicht teilnehmen und keine weiteren Erinnerungen erhalten möchten, klicken Sie bitte auf den folgenden Link:<br />{OPTOUTURL}<br /><br />If you are blocklisted but want to participate in this survey and want to receive invitations please click the following link:<br />{OPTINURL}]]></surveyls_email_invite>
    <surveyls_email_remind_subj><![CDATA[Erinnerung an die Teilnahme an einer Umfrage]]></surveyls_email_remind_subj>
    <surveyls_email_remind><![CDATA[Hallo {FIRSTNAME},<br /><br />Vor kurzem haben wir Sie zu einer Umfrage eingeladen.<br /><br />Zu unserem Bedauern haben wir bemerkt, dass Sie die Umfrage noch nicht ausgefüllt haben. Wir möchten Ihnen mitteilen, dass die Umfrage noch aktiv ist und würden uns freuen, wenn Sie teilnehmen könnten.<br /><br />Der Titel der Umfrage ist<br />'{SURVEYNAME}'<br /><br />'{SURVEYDESCRIPTION}'<br /><br />Um an dieser Umfrage teilzunehmen, klicken Sie bitte auf den unten stehenden Link.<br /><br />Mit freundlichen Grüßen,<br /><br />{ADMINNAME} ({ADMINEMAIL})<br /><br />----------------------------------------------<br />Klicken Sie hier um die Umfrage zu starten:<br />{SURVEYURL}<br /><br />Wenn Sie an diese Umfrage nicht teilnehmen und keine weiteren Erinnerungen erhalten möchten, klicken Sie bitte auf den folgenden Link:<br />{OPTOUTURL}]]></surveyls_email_remind>
    <surveyls_email_register_subj><![CDATA[Registrierungsbestätigung für Teilnahmeumfrage]]></surveyls_email_register_subj>
    <surveyls_email_register><![CDATA[Hallo {FIRSTNAME},<br /><br />Sie (oder jemand, der Ihre E-Mail benutzt hat) haben sich für eine Umfrage mit dem Titel {SURVEYNAME} angemeldet.<br /><br />Um an dieser Umfrage teilzunehmen, klicken Sie bitte auf den folgenden Link.<br /><br />{SURVEYURL}<br /><br />Wenn Sie irgendwelche Fragen zu dieser Umfrage haben oder wenn Sie sich _nicht_ für diese Umfrage angemeldet haben und sie glauben, dass Ihnen diese E-Mail irrtümlicherweise zugeschickt worden ist, kontaktieren Sie bitte {ADMINNAME} unter {ADMINEMAIL}.]]></surveyls_email_register>
    <surveyls_email_confirm_subj><![CDATA[Bestätigung für die Teilnahme an unserer Umfrage]]></surveyls_email_confirm_subj>
    <surveyls_email_confirm><![CDATA[Hallo {FIRSTNAME},<br /><br />Vielen Dank für die Teilnahme an der Umfrage mit dem Titel {SURVEYNAME}. Ihre Antworten wurden bei uns gespeichert.<br /><br />Wenn Sie irgendwelche Fragen zu dieser E-Mail haben, kontaktieren Sie bitte {ADMINNAME} unter {ADMINEMAIL}.<br /><br />Mit freundlichen Grüßen,<br /><br />{ADMINNAME}]]></surveyls_email_confirm>
    <surveyls_dateformat><![CDATA[1]]></surveyls_dateformat>
    <surveyls_alias/>
    <email_admin_notification_subj><![CDATA[Antwortabsendung für Umfrage {SURVEYNAME}]]></email_admin_notification_subj>
    <email_admin_notification><![CDATA[Hallo,<br /><br />Eine neue Antwort wurde für die Umfrage '{SURVEYNAME}' abgegeben.<br /><br />Klicken Sie auf den folgenden Link um den Antwortdatensatz anzusehen:<br />{VIEWRESPONSEURL}<br /><br />Klicken Sie auf den folgenden Link um den Antwortdatensatz zu bearbeiten:<br />{EDITRESPONSEURL}<br /><br />Um die Statistik zu sehen, klicken Sie hier:<br />{STATISTICSURL}]]></email_admin_notification>
    <email_admin_responses_subj><![CDATA[Antwortabsendung für Umfrage {SURVEYNAME} mit Ergebnissen]]></email_admin_responses_subj>
    <email_admin_responses><![CDATA[Hallo,<br /><br />Eine neue Antwort wurde für die Umfrage '{SURVEYNAME}' abgegeben.<br /><br />Klicken Sie auf den folgenden Link um den Antwortdatensatz anzusehen:<br />{VIEWRESPONSEURL}<br /><br />Klicken Sie auf den folgenden Link um den Antwortdatensatz zu bearbeiten:<br />{EDITRESPONSEURL}<br /><br />Um die Statistik zu sehen, klicken Sie hier:<br />{STATISTICSURL}<br /><br /><br />Die folgenden Antworten wurden vom Teilnehmer gegeben:<br />{ANSWERTABLE}]]></email_admin_responses>
    <surveyls_numberformat><![CDATA[1]]></surveyls_numberformat>
    <surveyls_language><![CDATA[de-easy]]></surveyls_language>
    <surveyls_title><![CDATA[Export_W_JSImpl.]]></surveyls_title>
    <surveyls_description><![CDATA[<p style="text-align:left;"><span style="font-family:Arial, Helvetica, sans-serif;"><span style="font-size:20px;"><strong>Diese Umfrage erfolgt anonym und kann ohne Erhebung und/oder Abfrage von personenbezogenen Daten ausgefüllt werden. (Postleitzahl, Gewicht, Größe etc. sind als freiwillige Angaben gekennzeichnet!)</strong></span></span></p>
]]></surveyls_description>
    <surveyls_welcometext><![CDATA[<div style="background:#eeeeee;border:1px solid #cccccc;padding:5px 10px;">
<p class="isSelectedEnd"><span style="font-size:16px;"><strong>Liebe Eltern, liebe Teilnehmerinnen, liebe Teilnehmer, </strong></span></p>

<p class="isSelectedEnd"><span style="font-size:16px;">der folgende Fragenkatalog <strong>FASQ (F</strong>etal <strong>A</strong>lcohol <strong>S</strong>ymptoms<strong> Q</strong>uestionnaire<strong>)</strong> wurde von <strong>Dr. rer. medic. Reinhold Feldmann / Klinikum Walstedde</strong> entwickelt.</span></p>

<p class="isSelectedEnd"><span style="font-size:16px;">Der Fragebogen unterstützt eine <strong>erste Einschätzung möglicher Hinweise auf eine Fetale Alkoholspektrumstörung (FASD)</strong>. Er kann bei <strong>Kindern, Jugendlichen bis 18 Jahren sowie bei Erwachsenen</strong> eingesetzt werden.</span></p>

<p class="isSelectedEnd"><span style="font-size:16px;">Der FASQ ist besonders hilfreich, wenn <strong>typische Merkmale einer FASD nicht eindeutig erkennbar sind oder bisher keine Diagnose gestellt wurde</strong>.</span></p>

<p class="isSelectedEnd"><span style="font-size:16px;">Außerdem hilft der Fragebogen dabei, <strong>FASD von anderen möglichen Ursachen ähnlicher Symptome zu unterscheiden</strong>, zum Beispiel <strong>ADHS</strong>, <strong>Autismus-Spektrum-Störungen (ASS)</strong> oder <strong>Belastungen durch Deprivation bzw. traumatische Erfahrungen (z. B. PTBS)</strong>.</span></p>

<p class="isSelectedEnd"><span style="font-size:16px;">Die Ergebnisse können dabei helfen einzuschätzen, <strong>ob eine fachärztliche Abklärung auf FASD sinnvoll oder empfohlen ist</strong>.</span></p>

<p><span style="font-size:16px;">Der FASQ <strong>stellt keine Diagnose</strong>, sondern dient <strong>als Orientierung und Unterstützung für eine mögliche weitere Abklärung</strong>.</span></p>
</div>

<div style="background:rgb(238,238,238);border:1px solid rgb(204,204,204);padding:5px 10px;text-align:left;"><span style="font-size:18px;"><span style="font-family:Arial, Helvetica, sans-serif;"><u><strong><span style="line-height:normal;">DER FASQ.online AN SICH HAT KEINE DIAGNOSTISCHE AUSSAGEKRAFT !!!</span></strong></u></span></span></div>

<p> </p>

<p><span style="font-family:Arial, Helvetica, sans-serif;"><span style="font-size:11pt;"><span style="line-height:normal;"><span style="font-size:12pt;">Im FASQ.online finden Sie eine Liste mit Verhaltensweisen und Eigenschaften. Bitte beurteilen Sie für jede Aussage, wie sehr sie auf Ihr Kind zutrifft unter:</span></span></span></span></p>

<ul style="margin-bottom:11px;">
	<li style="text-align:justify;margin-bottom:11px;">
	<p><span style="font-family:Arial, Helvetica, sans-serif;"><span style="font-size:11pt;"><span style="line-height:normal;"><span style="font-size:12pt;">Trifft die Aussage<b> gar nicht zu</b></span></span></span></span></p>
	</li>
	<li style="text-align:justify;margin-bottom:11px;">
	<p><span style="font-family:Arial, Helvetica, sans-serif;"><span style="font-size:11pt;"><span style="line-height:normal;"><span style="font-size:12pt;">Trifft die Aussage<b> manchmal oder etwas zu</b></span></span></span></span></p>
	</li>
	<li style="text-align:justify;margin-bottom:11px;">
	<p><span style="font-family:Arial, Helvetica, sans-serif;"><span style="font-size:11pt;"><span style="line-height:normal;"><span style="font-size:12pt;">Trifft die Aussage <b>häufig zu</b></span></span></span></span></p>
	</li>
	<li style="text-align:justify;margin-bottom:11px;">
	<p><span style="font-family:Arial, Helvetica, sans-serif;"><span style="font-size:11pt;"><span style="line-height:normal;"><span style="font-size:12pt;">Trifft die Aussage<b> voll zu</b></span></span></span></span></p>
	</li>
</ul>

<p align="left"> </p>

<p align="left"><span style="font-family:Arial, Helvetica, sans-serif;"><span style="font-size:11pt;"><span style="line-height:normal;"><span style="font-size:12pt;">Bitte lassen Sie sich Zeit bei der Bewertung und überlegen Sie genau, wie sehr die Aussage auf Ihr Kind/Jugendlichen/Erwachsenen zutrifft.</span></span></span></span></p>

<p align="left"><span style="font-family:Arial, Helvetica, sans-serif;"><span style="font-size:11pt;"><span style="line-height:normal;"><b><span style="font-size:12pt;">Los gehts!</span></b> </span></span></span></p>

<p align="left"><img src="/upload/surveys/738169/images/FASD_Logo_.png" style="width:419px;height:147px;" alt="FASD_Logo_.png" /></p>

<p align="left"> </p>

<p align="left"><span style="font-size:12px;">Projektförderung FASD ist FAKT! durch</span></p>

<p align="left"><img alt="" height="78" src="/upload/surveys/738169/images/logo-hamburg-fhh-sozialbehoerde-576x208%20(002).png" width="221" /></p>

<p align="left"> </p>
]]></surveyls_welcometext>
    <surveyls_endtext><![CDATA[<div style="max-width:760px;margin:14px auto;padding:14px 18px;border:1px solid #e3e7ee;background:#ffffff;font-family:Arial, Helvetica, sans-serif;color:#132235;line-height:1.25;font-size:13px;">
  <table style="width:100%;border-collapse:collapse;margin:0 0 8px;">
    <tr>
      <td style="vertical-align:top;padding:0;">
        <h1 style="margin:0 0 4px;font-size:24px;line-height:1.15;color:#132235;">FASQ.online Ergebnisbericht</h1>
        <p style="margin:0;font-size:14px;color:#4b5563;">Vielen Dank für Ihre Teilnahme.</p>
      </td>
      <td style="vertical-align:top;text-align:right;padding:0;width:190px;">
        <img src="/upload/surveys/881996/images/FASD_Logo_.png" alt="FASD Fachzentrum Hamburg e.V." style="max-width:175px;height:auto;" />
      </td>
    </tr>
  </table>
  <table style="width:100%;border-collapse:collapse;margin:0 0 10px;border:1px solid #d8dee8;background:#f8fafc;font-size:12.5px;">
    <tr>
      <td colspan="4" style="padding:6px 8px;font-weight:700;background:#eef2f7;border-bottom:1px solid #d8dee8;">Angaben zur Person</td>
    </tr>
    <tr>
      <td style="padding:5px 7px;color:#6b7280;font-weight:700;border-bottom:1px solid #e5e7eb;width:18%;">Name</td>
      <td style="padding:5px 7px;border-bottom:1px solid #e5e7eb;width:32%;">{TOKEN:FIRSTNAME} {TOKEN:LASTNAME}</td>
      <td style="padding:5px 7px;color:#6b7280;font-weight:700;border-bottom:1px solid #e5e7eb;width:18%;">Alter</td>
      <td style="padding:5px 7px;border-bottom:1px solid #e5e7eb;width:32%;">{G02Q02_SQ001} Jahre</td>
    </tr>
    <tr>
      <td style="padding:5px 7px;color:#6b7280;font-weight:700;border-bottom:1px solid #e5e7eb;">E-Mail</td>
      <td style="padding:5px 7px;border-bottom:1px solid #e5e7eb;">{EMAILSELF.NAOK}</td>
      <td style="padding:5px 7px;color:#6b7280;font-weight:700;border-bottom:1px solid #e5e7eb;">PLZ</td>
      <td style="padding:5px 7px;border-bottom:1px solid #e5e7eb;">{G02Q06}</td>
    </tr>
    <tr>
      <td style="padding:5px 7px;color:#6b7280;font-weight:700;">Gruppe</td>
      <td style="padding:5px 7px;">{Q0.shown}</td>
      <td style="padding:5px 7px;color:#6b7280;font-weight:700;">Größe/Gewicht</td>
      <td style="padding:5px 7px;">{G02Q02_SQ003} cm / {G02Q02_SQ002} kg</td>
    </tr>
  </table>
  <table style="width:100%;border-collapse:collapse;margin:0 0 10px;font-size:13px;">
    <tr>
      <td style="width:24%;border:1px solid #d8dee8;background:#f8fafc;padding:8px;text-align:left;vertical-align:middle;">
        <div style="font-size:11px;color:#6b7280;font-weight:700;margin-bottom:3px;">Erreichte Punktzahl</div>
        <div style="font-size:34px;font-weight:800;line-height:1;color:#132235;">{ASSESSMENT_CURRENT_TOTAL}</div>
      </td>
      <td style="border:1px solid #d8dee8;border-left:0;background:#ffffff;padding:8px 10px;vertical-align:middle;">
        <div style="font-size:16px;font-weight:700;margin:0 0 4px;">{if((ASSESSMENT_CURRENT_TOTAL >= 55) or ((G02Q02_SQ001 >= 2) and (G02Q02_SQ001 <= 5) and (ASSESSMENT_CURRENT_TOTAL >= 45)), 'Empfehlung einer FASD-Diagnostik', 'Keine Empfehlung einer FASD-Diagnostik')}</div>
        <div>{if((ASSESSMENT_CURRENT_TOTAL >= 55) or ((G02Q02_SQ001 >= 2) and (G02Q02_SQ001 <= 5) and (ASSESSMENT_CURRENT_TOTAL >= 45)), 'Es bestehen Hinweise, die eine umfängliche fachärztliche Abklärung auf FASD sinnvoll machen.', 'Auf Grundlage des erreichten Gesamtwerts wird aktuell keine FASD-Diagnostik empfohlen.')}</div>
      </td>
    </tr>
  </table>
  <div style="margin:8px 0 10px;padding:8px 10px;border:1px solid #d8dee8;background:#ffffff;font-size:12px;line-height:1.25;">
    <table style="width:100%;border-collapse:collapse;">
      <tr>
        <td style="vertical-align:middle;padding:0 10px 4px 0;">
          <p style="margin:0 0 5px;"><strong>Mit besten Grüßen Ihr FASD-Fachzentrum Hamburg e.V.</strong></p>
          <p style="margin:0;"><strong>Eine Danksagung an Dr. R. Feldmann/Tagesklinik Walstedde</strong> und vielen Dank für die finanzielle Förderung durch die Stadt Hamburg.</p>
        </td>
        <td style="vertical-align:middle;text-align:right;width:150px;padding:0;">
          <div style="font-size:10.5px;color:#6b7280;margin-bottom:3px;">Projektförderung durch</div>
          <img src="/upload/surveys/881996/images/logo-hamburg-fhh-sozialbehoerde-576x208%20(002).png" alt="Sozialbehörde Hamburg" style="max-width:135px;height:auto;" />
        </td>
      </tr>
    </table>
  </div>
  <style>
    @media print {
      body:not(.fasq-print-answers-only) .fasq-action-buttons { display: none !important; }
      .fasq-result-card { box-shadow: none !important; border-color: #cccccc !important; }
    }
  </style>
  <div class="fasq-action-buttons" style="margin:8px 0 0;padding:9px;border:1px solid #d8dee8;background:#f8fafc;text-align:left;font-size:12px;">
    <style>
      .fasq-action-buttons .fasq-btn,
      .fasq-action-buttons button.fasq-btn {
        display:inline-flex;
        align-items:center;
        justify-content:center;
        box-sizing:border-box;
        width:245px;
        min-height:42px;
        margin:0 5px 7px 5px;
        padding:9px 12px;
        border:0;
        border-radius:4px;
        color:#ffffff !important;
        text-decoration:none !important;
        font-family:Arial, Helvetica, sans-serif;
        font-size:13px;
        line-height:1.15;
        font-weight:700;
        cursor:pointer;
        vertical-align:top;
        text-align:center;
      }
      .fasq-action-buttons .fasq-btn-pdf { background:#000000; }
      .fasq-action-buttons .fasq-btn-self { background:#000000; }
      .fasq-action-buttons .fasq-btn-center { background:#000000; }
      .fasq-action-buttons .fasq-btn-answers { background:#000000; }
          </style>
    <a class="fasq-btn fasq-btn-pdf" href="javascript:window.print()">Seite als PDF speichern</a>
    <a class="fasq-btn fasq-btn-self" href="mailto:{EMAILSELF.NAOK}?subject=FASQ.online%20Ergebnisbericht&amp;body=FASQ.online%20Ergebnisbericht%0D%0A%0D%0AName:%20{TOKEN:FIRSTNAME}%20{TOKEN:LASTNAME}%0D%0AE-Mail:%20{EMAILSELF.NAOK}%0D%0APersonengruppe:%20{Q0.shown}%0D%0AAlter:%20{G02Q02_SQ001}%20Jahre%0D%0APLZ:%20{G02Q06}%0D%0AGröße/Gewicht:%20{G02Q02_SQ003}%20cm%20/%20{G02Q02_SQ002}%20kg%0D%0A%0D%0AErreichte%20Punktzahl:%20{ASSESSMENT_CURRENT_TOTAL}%0D%0ABewertung:%20{if((ASSESSMENT_CURRENT_TOTAL >= 55) or ((G02Q02_SQ001 >= 2) and (G02Q02_SQ001 <= 5) and (ASSESSMENT_CURRENT_TOTAL >= 45)), 'Empfehlung einer FASD-Diagnostik', 'Keine Empfehlung einer FASD-Diagnostik')}">Ergebnis per E-Mail an mich senden</a>
    <a class="fasq-btn fasq-btn-center" href="mailto:t.theen@fasd-fachzentrum.hamburg?subject=FASQ.online%20Ergebnisbericht%20zur%20Prüfung&amp;body=FASQ.online%20Ergebnisbericht%0D%0A%0D%0AName:%20{TOKEN:FIRSTNAME}%20{TOKEN:LASTNAME}%0D%0AE-Mail:%20{EMAILSELF.NAOK}%0D%0APersonengruppe:%20{Q0.shown}%0D%0AAlter:%20{G02Q02_SQ001}%20Jahre%0D%0APLZ:%20{G02Q06}%0D%0AGröße/Gewicht:%20{G02Q02_SQ003}%20cm%20/%20{G02Q02_SQ002}%20kg%0D%0A%0D%0AErreichte%20Punktzahl:%20{ASSESSMENT_CURRENT_TOTAL}%0D%0ABewertung:%20{if((ASSESSMENT_CURRENT_TOTAL >= 55) or ((G02Q02_SQ001 >= 2) and (G02Q02_SQ001 <= 5) and (ASSESSMENT_CURRENT_TOTAL >= 45)), 'Empfehlung einer FASD-Diagnostik', 'Keine Empfehlung einer FASD-Diagnostik')}">Ergebnis ans Fachzentrum senden</a>
    <div style="margin-top:2px;color:#6b7280;font-size:11.5px;line-height:1.25;">PDF: Es öffnet sich der Druckdialog. Die Antworten werden automatisch angezeigt. Bitte „Als PDF speichern" im Druckdialog wählen. E-Mail: Es öffnet sich Ihr E-Mail-Programm mit vorausgefülltem Text; der Versand erfolgt erst nach Ihrer Bestätigung.</div>
    </div>
</div>]]></surveyls_endtext>
    <surveyls_policy_notice><![CDATA[<p>Ich möchte an der anynomen Unmfrage teilnehmen! Es ist mit bewusst das keine personenbezogenen Daten erhoben und/oder gespeichert werden.</p>

<p>Daher ist der erhaltene Link nur einmalig nutzbar. Im Anschluss besteht die Möglichkeit die Auswertung per PDF herunterzuladen! </p>
]]></surveyls_policy_notice>
