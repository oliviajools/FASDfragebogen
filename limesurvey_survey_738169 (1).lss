   <row>
    <id><![CDATA[5127]]></id>
    <qid><![CDATA[5126]]></qid>
    <question><![CDATA[<div style="max-width:760px;margin:18px auto;text-align:left;font-family:Arial, Helvetica, sans-serif;color:#132235;line-height:1.28;font-size:14px;">
  <h1 style="margin:0 0 10px;font-size:24px;line-height:1.15;text-align:left;">Ergebnis des FASQ</h1>
  <table style="width:100%;border-collapse:collapse;margin:0 0 12px;border:1px solid #d8dee8;background:#f8fafc;font-size:13px;">
    <tr>
      <td style="padding:6px 8px;color:#6b7280;font-weight:700;border-bottom:1px solid #e5e7eb;width:18%;">Name</td>
      <td style="padding:6px 8px;border-bottom:1px solid #e5e7eb;width:32%;">{TOKEN:FIRSTNAME} {TOKEN:LASTNAME}</td>
      <td style="padding:6px 8px;color:#6b7280;font-weight:700;border-bottom:1px solid #e5e7eb;width:18%;">Alter</td>
      <td style="padding:6px 8px;border-bottom:1px solid #e5e7eb;width:32%;">{G02Q02_SQ001} Jahre</td>
    </tr>
    <tr>
      <td style="padding:6px 8px;color:#6b7280;font-weight:700;border-bottom:1px solid #e5e7eb;">E-Mail</td>
      <td style="padding:6px 8px;border-bottom:1px solid #e5e7eb;">{TOKEN:EMAIL}</td>
      <td style="padding:6px 8px;color:#6b7280;font-weight:700;border-bottom:1px solid #e5e7eb;">PLZ</td>
      <td style="padding:6px 8px;border-bottom:1px solid #e5e7eb;">{G02Q06}</td>
    </tr>
    <tr>
      <td style="padding:6px 8px;color:#6b7280;font-weight:700;border-bottom:1px solid #e5e7eb;">Gruppe</td>
      <td style="padding:6px 8px;border-bottom:1px solid #e5e7eb;">{Q0.shown}</td>
      <td style="padding:6px 8px;color:#6b7280;font-weight:700;border-bottom:1px solid #e5e7eb;">Größe/Gewicht</td>
      <td style="padding:6px 8px;border-bottom:1px solid #e5e7eb;">{G02Q02_SQ003} cm / {G02Q02_SQ002} kg</td>
    </tr>
  </table>
  <div style="display:table;width:100%;border-collapse:collapse;margin:0 0 12px;">
    <div style="display:table-cell;width:25%;vertical-align:top;border:1px solid #d8dee8;background:#f8fafc;padding:10px;text-align:left;">
      <div style="font-size:12px;color:#6b7280;font-weight:700;margin-bottom:4px;">Punktzahl</div>
      <div style="font-size:38px;font-weight:800;line-height:1;">{ASSESSMENT_CURRENT_TOTAL}</div>
    </div>
    <div style="display:table-cell;vertical-align:top;border:1px solid #d8dee8;border-left:0;background:#ffffff;padding:10px 12px;">
      <div style="font-size:16px;font-weight:700;margin:0 0 5px;">{if((ASSESSMENT_CURRENT_TOTAL >= 55) or ((G02Q02_SQ001 >= 2) and (G02Q02_SQ001 <= 5) and (ASSESSMENT_CURRENT_TOTAL >= 45)), 'Empfehlung zur FASD-Diagnostik', 'Keine Empfehlung zur FASD-Diagnostik')}</div>
      <div style="font-size:13px;">{if((ASSESSMENT_CURRENT_TOTAL >= 55) or ((G02Q02_SQ001 >= 2) and (G02Q02_SQ001 <= 5) and (ASSESSMENT_CURRENT_TOTAL >= 45)), 'Es bestehen Hinweise, die eine umfängliche fachärztliche Abklärung auf FASD sinnvoll machen.', 'Auf Grundlage des erreichten Gesamtwerts wird aktuell keine FASD-Diagnostik empfohlen.')}</div>
    </div>
  </div>
  <p style="font-size:14px;text-align:left;margin:10px 0 0;">Bitte klicken Sie nun auf <strong>Absenden</strong>. Danach erscheint die Druckansicht.</p>
</div>]]></question>
    <help/>
    <script/>
    <language><![CDATA[de-easy]]></language>
   </row>
